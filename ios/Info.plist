<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The keys Xcode cannot generate from build settings; the rest are INFOPLIST_KEY_ settings in the project. -->
<plist version="1.0">
<dict>
	<key>NSBonjourServices</key>
	<array>
		<string>_quizparty._tcp</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Quiz Party finds and joins parties on your Wi-Fi.</string>
	<key>NSCameraUsageDescription</key>
	<string>Quiz Party scans the QR code on the big screen to join the party.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>org.skingle.bruce-quiz-party.join</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>quizparty</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
